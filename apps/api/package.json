{
  "name": "@shopnetic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shopnetic backend — NestJS modular monolith",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@shopnetic/auth": "workspace:*",
    "@shopnetic/contracts": "workspace:*",
    "@shopnetic/db": "workspace:*",
    "@shopnetic/observability": "workspace:*",
    "cookie-parser": "1.4.7",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "nodemailer": "6.9.16",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@shopnetic/config": "workspace:*",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
