# API process environment.
NODE_ENV=development
PORT=4000
APP_VERSION=0.0.0

# Postgres + Redis — match infra/docker/docker-compose.yml (host ports 5433 / 6380).
DATABASE_URL="postgresql://shopnetic:shopnetic@localhost:5433/shopnetic"
REDIS_URL="redis://localhost:6380"

# Access-token signing (RS256). Leave both unset in dev for an ephemeral keypair
# (tokens then don't survive a restart). Required in production. Use \n for
# newlines if your secret store gives single-line values.
JWT_ISSUER="https://shopnetic.local"
JWT_ACCESS_TTL_SECONDS=900
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Refresh sessions + email verification.
AUTH_REFRESH_TTL_DAYS=30
VERIFICATION_TTL_HOURS=24

# Outbound email — Mailpit locally (SMTP :1025, web UI http://localhost:8025).
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Shopnetic <no-reply@shopnetic.local>"

# Where verification / login links in emails point (the storefront).
APP_WEB_URL="http://localhost:3000"

# Check new passwords against Have I Been Pwned (k-anonymity). Off by default.
PASSWORD_BREACH_CHECK=false
