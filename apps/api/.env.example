# API process environment.
NODE_ENV=development
PORT=4000
APP_VERSION=0.0.0

# Postgres + Redis — match infra/docker/docker-compose.yml (host ports 5433 / 6380).
DATABASE_URL="postgresql://shopnetic:shopnetic@localhost:5433/shopnetic"
REDIS_URL="redis://localhost:6380"

# Access-token signing (RS256). Leave both unset in dev for an ephemeral keypair
# (tokens then don't survive a restart). Required in production. Use \n for
# newlines if your secret store gives single-line values.
JWT_ISSUER="https://shopnetic.local"
JWT_ACCESS_TTL_SECONDS=900
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Refresh sessions + email verification.
AUTH_REFRESH_TTL_DAYS=30
AUTH_STAFF_REFRESH_TTL_HOURS=8
VERIFICATION_TTL_HOURS=24

# Staff TOTP seed encryption (AES-256-GCM). 32 bytes, base64. Dev may omit (a
# fixed dev key is derived). Required in production.
# TOTP_ENC_KEY="<base64 of 32 random bytes>"
TOTP_ISSUER="Shopnetic"
TOTP_WINDOW_STEPS=1        # dev may raise (10 = ±5min) for manual testing

# Outbound email — Mailpit locally (SMTP :1025, web UI http://localhost:8025).
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Shopnetic <no-reply@shopnetic.local>"

# Where email links point.
APP_WEB_URL="http://localhost:3000"      # storefront (buyer verify / login)
ADMIN_WEB_URL="http://localhost:3002"    # admin app (staff invite accept)
ADMIN_BASE_PATH="x7f2k9t3m1qp"           # must match apps/admin's route folder

# Check new passwords against Have I Been Pwned (k-anonymity). Off by default.
PASSWORD_BREACH_CHECK=false

# DEV ONLY — skip staff TOTP + buyer email-verify gate. Ignored when NODE_ENV=test,
# rejected when NODE_ENV=production. Flip off to test the real flow.
DEV_AUTH_RELAXED=false

# DEV ONLY — turn off every @RateLimit guard (login, refresh, invites, …) so
# local iteration isn't throttled. Ignored when NODE_ENV=test, rejected when
# NODE_ENV=production. Leave false to exercise the real limits.
DEV_RATE_LIMIT_DISABLED=false

# DEV ONLY — artificially delay matching responses (ms) to eyeball loading
# states under realistic latency. 0 = off. Only wired when NODE_ENV=development
# (never test, rejected in production). A per-request `x-debug-delay: <ms>`
# header overrides this for a single request/tab.
DEV_RESPONSE_DELAY_MS=0
# DEV ONLY — comma-separated path prefixes DEV_RESPONSE_DELAY_MS (and the
# header override) apply to, e.g. "/admin/v1/categories". Empty = every request.
DEV_RESPONSE_DELAY_ROUTES=

# DEV ONLY — return a synthetic error for matching requests instead of handling
# them, to check every frontend error state. 0 = off. Only wired when
# NODE_ENV=development (never test, rejected in production). A per-request
# `x-debug-fault: <status>` header overrides this; `x-debug-fault: off` forces a
# real response. Runs after DEV_RESPONSE_DELAY_MS, so the two compose.
DEV_FAULT_STATUS=0
# DEV ONLY — comma-separated path prefixes DEV_FAULT_STATUS (and the header
# override) apply to, e.g. "/admin/v1/categories". Empty = every request.
DEV_FAULT_ROUTES=
# DEV ONLY — injected body shape: envelope (normal RFC-9457 error), malformed
# (broken JSON), or empty (no body — exercises the client's non-JSON path).
DEV_FAULT_BODY=envelope
