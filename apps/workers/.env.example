NODE_ENV=development

# Same Redis apps/api's queues talk to — this process is the consumer side
# (plan/31-background-jobs-and-queues.md).
REDIS_URL="redis://localhost:6380"

# Outbound email. Point at Mailpit locally; must match apps/api's real
# values in any environment where mail actually needs to deliver.
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Shopnetic <no-reply@shopnetic.local>"
