# Local Postgres from infra/docker/docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://shopnetic:shopnetic@localhost:5433/shopnetic"

# Un-pooled connection for `prisma migrate` / introspection. Locally it is the
# same as DATABASE_URL; in deployed envs it bypasses PgBouncer.
# DIRECT_URL="postgresql://shopnetic:shopnetic@localhost:5433/shopnetic"

# Optional: seed a first Super Admin (identity.account + credential + global grant).
# Set BOTH or NEITHER. Password min length 12. Used only by `pnpm db:seed`.
# BOOTSTRAP_SUPERADMIN_EMAIL="owner@example.com"
# BOOTSTRAP_SUPERADMIN_PASSWORD="change-me-please-1234"

# Demo catalog data (categories, brands, option types, products, variants).
# `pnpm db:seed` runs it by default outside production. Set "false" to skip it,
# "true" to force it even when NODE_ENV=production. Idempotent.
# SEED_DEMO="true"
