// Shopnetic database schema.
//
// One Prisma schema, models grouped by bounded context; each context owns its
// own PostgreSQL schema (`@@schema("identity")`, …) — plan/02-architecture.md §5,
// plan/07-data-model.md. No cross-schema foreign keys: cross-context links are
// id-only columns reconciled via events.
//
// Conventions (plan/25-database-conventions.md §1.5):
//   - PK `id` is a v7 UUID (time-sortable), generated by Prisma Client.
//   - snake_case tables/columns via @map/@@map; timestamps are timestamptz.
//   - money (later contexts) = bigint minor units + char(3) currency.
//   - one `outbox` table per schema for reliable event publishing.
//   - soft delete (`deleted_at`) on user-facing entities; auth/token rows are
//     hard/transient; `audit_event` is append-only and never deleted.
//
// Only `identity` is populated so far. Other context schemas are added to the
// `schemas` list as their models land (Prisma rejects an unused schema).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, ltree]
  schemas    = ["identity", "catalog"]
}

// ─────────────────────────────────────────────────────────────────────────────
// Context: Identity & Access  (plan/03-users-and-rbac.md, plan/07 §"identity")
// ─────────────────────────────────────────────────────────────────────────────

/// One per human login. Marketplace and staff accounts never share a row and
/// never share a token audience (plan/03 §1).
model Account {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext
  plane           AccountPlane
  status          AccountStatus @default(active)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  phone           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  credential         Credential?
  grants             Grant[]
  sessions           Session[]
  emailVerifications  EmailVerification[]
  totpSecret         TotpSecret?
  recoveryCodes      RecoveryCode[]
  invitesSent        StaffInvite[]      @relation("InviteInvitedBy")
  inviteAccepted     StaffInvite?       @relation("InviteAcceptedBy")
  auditEvents        AuditEvent[]       @relation("AuditActor")

  @@index([deletedAt])
  @@map("account")
  @@schema("identity")
}

/// Password credential. Split from `account` so cost params can be raised and
/// the hash re-written without touching the account row (plan/16 §1).
model Credential {
  id           String   @id @default(uuid(7)) @db.Uuid
  accountId    String   @unique @map("account_id") @db.Uuid
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  passwordHash String   @map("password_hash")
  hashAlgo     String   @default("argon2id") @map("hash_algo")
  params       Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credential")
  @@schema("identity")
}

/// Single-use tokens for email verification and password reset. Only the hash
/// is stored.
model EmailVerification {
  id         String   @id @default(uuid(7)) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purpose    EmailVerificationPurpose
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId])
  @@map("email_verification")
  @@schema("identity")
}

/// One row per issued refresh token. Rotation writes a new row with the same
/// `family_id` and points the old row's `replaced_by_id` at it; presenting a
/// already-rotated token revokes the whole family (plan/16 §1).
model Session {
  id               String   @id @default(uuid(7)) @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  familyId         String   @map("family_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ip               String?  @db.Inet
  issuedAt         DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    SessionRevokedReason? @map("revoked_reason")
  replacedById     String?  @unique @map("replaced_by_id") @db.Uuid
  replacedBy       Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces         Session? @relation("SessionRotation")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([accountId])
  @@index([familyId])
  @@map("session")
  @@schema("identity")
}

/// TOTP shared secret (encrypted at the application layer). Mandatory for staff,
/// optional for buyers (plan/16 §1).
model TotpSecret {
  id              String   @id @default(uuid(7)) @db.Uuid
  accountId       String   @unique @map("account_id") @db.Uuid
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  secretEncrypted String   @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("totp_secret")
  @@schema("identity")
}

/// One-time MFA recovery codes; only the hash is stored.
model RecoveryCode {
  id        String   @id @default(uuid(7)) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  codeHash  String   @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([accountId, codeHash])
  @@index([accountId])
  @@map("recovery_code")
  @@schema("identity")
}

/// Named bundle of permissions. `is_system` roles are seeded and cannot be
/// deleted; a Super Admin may add custom staff roles later (plan/03 §2).
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions  RolePermission[]
  grants       Grant[]
  staffInvites StaffInvite[]

  @@map("role")
  @@schema("identity")
}

/// A single `resource:verb` permission. Seeded from `@shopnetic/auth`.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permission")
  @@schema("identity")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
  @@schema("identity")
}

/// An account's effective authority: this role over this data boundary.
/// `scope_id` holds the sellerId for `seller` scope; null for `self` / `global`.
model Grant {
  id        String   @id @default(uuid(7)) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeType GrantScopeType @map("scope_type")
  scopeId   String?  @map("scope_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // NOTE: Postgres treats NULLs as distinct, so this does not block a duplicate
  // (account, role, global, NULL). The seed and grant-writer paths de-dupe
  // explicitly; a `NULLS NOT DISTINCT` index lands when Prisma supports it.
  @@unique([accountId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("grant")
  @@schema("identity")
}

/// Invite-only staff onboarding (plan/03 §1). Only the token hash is stored.
model StaffInvite {
  id                  String   @id @default(uuid(7)) @db.Uuid
  email               String   @db.Citext
  roleId              String   @map("role_id") @db.Uuid
  role                Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedByAccountId  String   @map("invited_by_account_id") @db.Uuid
  invitedBy           Account  @relation("InviteInvitedBy", fields: [invitedByAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tokenHash           String   @unique @map("token_hash")
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedAccountId   String?  @unique @map("accepted_account_id") @db.Uuid
  acceptedAccount     Account? @relation("InviteAcceptedBy", fields: [acceptedAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@map("staff_invite")
  @@schema("identity")
}

/// Append-only. Every privileged mutation writes one (plan/16 §8). Never
/// updated, never deleted. Monthly range partitioning is added via raw SQL when
/// volume warrants (plan/25 §1.5).
model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  actor          Account? @relation("AuditActor", fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  before         Json?
  after          Json?
  reason         String?
  ip             String?  @db.Inet
  correlationId  String?  @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorAccountId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_event")
  @@schema("identity")
}

/// Transactional outbox for the identity context (plan/02 §4). A dispatcher
/// (apps/workers, later) publishes unpublished rows and sets `published_at`.
model Outbox {
  id            String   @id @default(uuid(7)) @db.Uuid
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type")
  payload       Json
  headers       Json?
  attempts      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt])
  @@map("outbox")
  @@schema("identity")
}

enum AccountPlane {
  marketplace
  staff

  @@schema("identity")
}

enum AccountStatus {
  active
  locked
  disabled
  anonymized

  @@schema("identity")
}

enum EmailVerificationPurpose {
  verify_email
  password_reset

  @@schema("identity")
}

enum SessionRevokedReason {
  logout
  rotation
  reuse_detected
  admin
  expired
  password_change

  @@schema("identity")
}

enum GrantScopeType {
  self
  seller
  global

  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────────
// Context: Catalog  (plan/07 §"catalog", plan/26)
// ─────────────────────────────────────────────────────────────────────────────

/// Category tree. `name_i18n` is a localized field (`24` §5): `{ "en": "Phones" }`.
/// `path` is a materialized ltree of slug segments for fast subtree queries;
/// it is maintained by the catalog service (raw SQL) inside a transaction.
model Category {
  id               String                   @id @default(uuid(7)) @db.Uuid
  parentId         String?                  @map("parent_id") @db.Uuid
  parent           Category?                @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children         Category[]               @relation("CategoryTree")
  slug             String
  nameI18n         Json                     @map("name_i18n")
  path             Unsupported("ltree")?
  position         Int                      @default(0)
  isActive         Boolean                  @default(true) @map("is_active")
  brandRequirement CategoryBrandRequirement @default(optional) @map("brand_requirement")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?                @map("deleted_at") @db.Timestamptz(6)

  // Sibling slugs are unique. NULL parent (roots) is handled in the service —
  // Postgres treats NULLs as distinct, so this index does not cover it.
  @@unique([parentId, slug])
  @@index([parentId])
  @@index([deletedAt])
  @@map("category")
  @@schema("catalog")
}

enum CategoryBrandRequirement {
  required
  optional
  none

  @@schema("catalog")
}

/// Transactional outbox for the catalog context (plan/02 §4). A dispatcher
/// (apps/workers, later) publishes unpublished rows.
model CatalogOutbox {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  headers       Json?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt])
  @@map("outbox")
  @@schema("catalog")
}
